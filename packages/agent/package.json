{
  "name": "@faapi/agent",
  "version": "3.3.0",
  "description": "Agent runtime for faapi — LLM-driven ReAct loop over scanned agent / tool registries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@faapi/faapi": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@faapi/faapi": "workspace:^",
    "typescript": ">=5.7.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faapi/faapi.git",
    "directory": "packages/agent"
  },
  "keywords": [
    "faapi",
    "agent",
    "llm",
    "react",
    "tool-calling",
    "function-calling",
    "sub-agent",
    "openai",
    "typescript",
    "nodejs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
